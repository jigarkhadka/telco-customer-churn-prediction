{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Telco Customer Churn Prediction\n",
    "\n",
    "End-to-end ML pipeline on the IBM Telco Customer Churn dataset:\n",
    "EDA → preprocessing → feature selection (Chi² / ANOVA-F / RFECV) → model\n",
    "comparison → hyperparameter tuning → final assessment.\n",
    "\n",
    "## Contents\n",
    "1. Load the data\n",
    "2. Exploratory data analysis\n",
    "3. Preprocessing pipeline\n",
    "4. Feature selection (Chi², ANOVA-F, RFECV)\n",
    "5. Model comparison\n",
    "6. Hyperparameter tuning\n",
    "7. Final assessment\n",
    "\n",
    "**Environment:** Python ≥ 3.9, scikit-learn ≥ 1.2 (for `set_output`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import math\n",
    "import warnings\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from sklearn.base import clone\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.feature_selection import RFECV, SelectKBest, chi2, f_classif\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import accuracy_score, f1_score, precision_score\n",
    "from sklearn.model_selection import GridSearchCV, cross_val_score, train_test_split\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder, OrdinalEncoder\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "sns.set_style(\"whitegrid\")\n",
    "\n",
    "RANDOM_STATE = 42\n",
    "DATA_PATH = "data/WA_Fn-UseC_-Telco-Customer-Churn.csv\"  # adjust to your path"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 1. Load the Data"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data = pd.read_csv(DATA_PATH)\n",
    "X = data.drop(\"Churn\", axis=1)\n",
    "y = data[\"Churn\"]\n",
    "data.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data.tail()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 2. Exploratory Data Analysis"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data.info()\n",
    "print(f\"\\nDuplicates: {data.duplicated().sum()}\")\n",
    "data.isnull().sum().rename(\"Null counts\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data.nunique().rename(\"Unique values\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data.describe(include=[np.number])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.1 Data-type audit\n",
    "\n",
    "We look at string-typed columns explicitly. `pandas >= 2` may report\n",
    "string columns as `str` / `string` dtype, so we include both `object`\n",
    "and `string` in the `select_dtypes` call."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "str_data = data.select_dtypes(include=[\"object\", \"string\"])\n",
    "numerical_data = data.select_dtypes(include=[np.number])\n",
    "\n",
    "print(f\"String columns: {str_data.columns.size}\")\n",
    "for c in str_data.columns:\n",
    "    print(\"  -\", c)\n",
    "\n",
    "print(f\"\\nNumeric columns: {numerical_data.columns.size}\")\n",
    "for c in numerical_data.columns:\n",
    "    print(\"  -\", c)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**`TotalCharges` is stored as a string but should be numeric.** It contains\n",
    "whitespace entries for customers with zero tenure; we coerce to numeric\n",
    "and let the imputer in the pipeline handle the resulting NaNs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data[\"TotalCharges\"] = pd.to_numeric(data[\"TotalCharges\"], errors=\"coerce\")\n",
    "X[\"TotalCharges\"]    = pd.to_numeric(X[\"TotalCharges\"],    errors=\"coerce\")\n",
    "print(f\"TotalCharges NaNs after coercion: {data['TotalCharges'].isnull().sum()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 2.2 Categorical feature distributions"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "cat_cols = [c for c in X.columns if 2 <= X[c].nunique() < 10]\n",
    "\n",
    "n_cols = 3\n",
    "n_rows = math.ceil(len(cat_cols) / n_cols)\n",
    "fig, axes = plt.subplots(n_rows, n_cols, figsize=(16, n_rows * 4))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for idx, col in enumerate(cat_cols):\n",
    "    sns.countplot(data=data, x=col, hue=\"Churn\", ax=axes[idx])\n",
    "    axes[idx].set_title(f\"Distribution of {col}\")\n",
    "    axes[idx].tick_params(axis=\"x\", rotation=30)\n",
    "    max_count = data[col].value_counts().max()\n",
    "    axes[idx].set_ylim(0, max_count * 1.1)\n",
    "\n",
    "for i in range(len(cat_cols), len(axes)):\n",
    "    fig.delaxes(axes[i])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 2.3 Numeric feature distributions"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "numeric_cols = [c for c in X.columns if c not in cat_cols]\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(10, 10))\n",
    "for idx, col in enumerate(numeric_cols):\n",
    "    row, column = divmod(idx, 2)\n",
    "    sns.histplot(data=X, x=col, ax=axes[row, column])\n",
    "    axes[row, column].set_title(col, weight=\"bold\", color=\"red\")\n",
    "\n",
    "plt.suptitle(\"Distribution of Numeric Columns\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Observations**\n",
    "- `MonthlyCharges` is roughly bimodal / asymmetric.\n",
    "- `TotalCharges` shows a downward trend — higher totals are rarer.\n",
    "- `tenure` is left-skewed with a large spike near zero (new customers)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Preprocessing Pipeline\n",
    "\n",
    "| Feature type | Strategy |\n",
    "|---|---|\n",
    "| Binary / ordinal | `OrdinalEncoder` |\n",
    "| Nominal (multi-class) | `OneHotEncoder(handle_unknown='ignore')` |\n",
    "| `TotalCharges` (NaNs) | `SimpleImputer` |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Encode target\n",
    "y = data[\"Churn\"].map({\"No\": 0, \"Yes\": 1})\n",
    "\n",
    "# Stratified split\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y\n",
    ")\n",
    "\n",
    "ordinal = [c for c in cat_cols if X[c].nunique() == 2]\n",
    "nominal = [c for c in cat_cols if c not in ordinal]\n",
    "\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\"ordinal\", OrdinalEncoder(), ordinal),\n",
    "        (\"nominal\", OneHotEncoder(sparse_output=False, handle_unknown=\"ignore\"), nominal),\n",
    "        (\"imputer\", SimpleImputer(), [\"TotalCharges\"]),\n",
    "    ],\n",
    "    remainder=\"drop\",\n",
    ")\n",
    "preprocessor.set_output(transform=\"pandas\")\n",
    "\n",
    "print(f\"Ordinal features: {ordinal}\")\n",
    "print(f\"Nominal features: {nominal}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Feature Selection\n",
    "\n",
    "Three selectors × three estimators:\n",
    "- `SelectKBest(chi2)` — filter, requires non-negative features (satisfied)\n",
    "- `SelectKBest(f_classif)` — ANOVA F-value filter\n",
    "- `RFECV` — recursive elimination with 5-fold CV, one wrapper per model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "features_table = pd.DataFrame(columns=[\"Selector\", \"Model\", \"selected_features\"])\n",
    "\n",
    "\n",
    "def select_features(X1, y1, selector_type, k=None, estimator=None):\n",
    "    \"\"\"Fit a feature selector on preprocessed training data.\n",
    "\n",
    "    Records results into `features_table` and returns the list of\n",
    "    selected feature names.\n",
    "    \"\"\"\n",
    "    X_proc = preprocessor.fit_transform(X1)\n",
    "    feature_names = preprocessor.get_feature_names_out()\n",
    "    model_name = estimator.__class__.__name__ if estimator is not None else \"None\"\n",
    "\n",
    "    if selector_type is RFECV:\n",
    "        if estimator is None:\n",
    "            raise ValueError(\"RFECV requires an estimator.\")\n",
    "        selector = RFECV(estimator=clone(estimator), step=1, cv=5)\n",
    "        selector_name = f\"RFECV ({model_name})\"\n",
    "    else:\n",
    "        selector = SelectKBest(score_func=selector_type, k=k)\n",
    "        selector_name = getattr(selector_type, \"__name__\", str(selector_type))\n",
    "\n",
    "    selector.fit(X_proc, y1)\n",
    "    selected = feature_names[selector.get_support()].tolist()\n",
    "\n",
    "    features_table.loc[len(features_table)] = [selector_name, model_name, selected]\n",
    "    return selected\n",
    "\n",
    "\n",
    "def select_k(score_func, estimator, X1, y1, k_range=range(1, 10)):\n",
    "    \"\"\"Grid-search the best `k` for SelectKBest inside a Pipeline.\"\"\"\n",
    "    pipeline = Pipeline([\n",
    "        (\"preprocessor\", preprocessor),\n",
    "        (\"selector\", SelectKBest(score_func=score_func)),\n",
    "        (\"estimator\", estimator),\n",
    "    ])\n",
    "    grid = GridSearchCV(pipeline, {\"selector__k\": k_range}, cv=5, scoring=\"accuracy\")\n",
    "    grid.fit(X1, y1)\n",
    "    return f\"Best k for {score_func.__name__}: {grid.best_params_['selector__k']}\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 4.1 Chi-Squared Test"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Logistic Regression:\", select_k(chi2, LogisticRegression(), X_train, y_train))\n",
    "print(\"Decision Tree    :\", select_k(chi2, DecisionTreeClassifier(random_state=RANDOM_STATE), X_train, y_train))\n",
    "print(\"Random Forest    :\", select_k(chi2, RandomForestClassifier(random_state=RANDOM_STATE), X_train, y_train))\n",
    "\n",
    "chi_selected = select_features(X_train, y_train, selector_type=chi2, k=9)\n",
    "print(f\"\\nTop 9 Chi² features: {chi_selected}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "> **Note:** Tuning `k` per model yields a marginal accuracy gain that does not justify the extra compute. We fix `k = 9` for Chi²."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 4.2 ANOVA F-test"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Logistic Regression:\", select_k(f_classif, LogisticRegression(), X_train, y_train))\n",
    "print(\"Decision Tree    :\", select_k(f_classif, DecisionTreeClassifier(random_state=RANDOM_STATE), X_train, y_train))\n",
    "print(\"Random Forest    :\", select_k(f_classif, RandomForestClassifier(random_state=RANDOM_STATE), X_train, y_train))\n",
    "\n",
    "f_selected = select_features(X_train, y_train, selector_type=f_classif, k=8)\n",
    "print(f\"\\nTop 8 ANOVA-F features: {f_selected}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "> **Note:** Same reasoning as above — we fix `k = 8` for ANOVA-F."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 4.3 Recursive Feature Elimination with CV"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "rfecv_log_reg       = select_features(X_train, y_train, selector_type=RFECV, estimator=LogisticRegression())\n",
    "rfecv_decision_tree = select_features(X_train, y_train, selector_type=RFECV, estimator=DecisionTreeClassifier(random_state=RANDOM_STATE))\n",
    "rfecv_random_forest = select_features(X_train, y_train, selector_type=RFECV, estimator=RandomForestClassifier(random_state=RANDOM_STATE))\n",
    "\n",
    "features_table"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Model Comparison\n",
    "\n",
    "Each estimator is evaluated under four conditions:\n",
    "- **Baseline** — all engineered features, no tuning\n",
    "- **Chi-Selected** — top-k by Chi²\n",
    "- **Anova-F** — top-k by F-test\n",
    "- **RFECV** — per-model recursive elimination\n",
    "\n",
    "CV is computed on the *same feature subset* the model is trained on."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "models_table = pd.DataFrame(columns=[\"Model\", \"Type\", \"Accuracy\", \"Precision\", \"F1\", \"CV\"])\n",
    "\n",
    "\n",
    "def train_model(estimator, X1, y1, X1_test, y1_test, type_=\"Baseline\", features=None):\n",
    "    \"\"\"Fit, evaluate, and return a row for `models_table`.\n",
    "\n",
    "    `features=None` → use all preprocessed features.\n",
    "    Otherwise `features` is a list of column names to subset on.\n",
    "    \"\"\"\n",
    "    X_proc      = preprocessor.fit_transform(X1)\n",
    "    X_test_proc = preprocessor.transform(X1_test)\n",
    "\n",
    "    if features is None:\n",
    "        features = X_proc.columns.tolist()\n",
    "\n",
    "    X_model      = X_proc[features]\n",
    "    X_test_model = X_test_proc[features]\n",
    "\n",
    "    model = clone(estimator)\n",
    "    model.fit(X_model, y1)\n",
    "    y_pred = model.predict(X_test_model)\n",
    "\n",
    "    accuracy  = accuracy_score(y1_test, y_pred)\n",
    "    precision = precision_score(y1_test, y_pred)\n",
    "    f1        = f1_score(y1_test, y_pred)\n",
    "    cv = cross_val_score(model, X_model, y1, scoring=\"accuracy\", cv=5).mean()\n",
    "\n",
    "    return [estimator.__class__.__name__, type_, accuracy, precision, f1, cv]\n",
    "\n",
    "\n",
    "def add_model_row(estimator, type_, features=None):\n",
    "    models_table.loc[len(models_table)] = train_model(\n",
    "        estimator, X_train, y_train, X_test, y_test, type_=type_, features=features\n",
    "    )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 5.1 Baseline Models"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "base_log_reg       = LogisticRegression(random_state=RANDOM_STATE)\n",
    "base_decision_tree = DecisionTreeClassifier(random_state=RANDOM_STATE)\n",
    "base_random_forest = RandomForestClassifier(random_state=RANDOM_STATE)\n",
    "\n",
    "add_model_row(base_log_reg,       type_=\"Baseline\")\n",
    "add_model_row(base_decision_tree, type_=\"Baseline\")\n",
    "add_model_row(base_random_forest, type_=\"Baseline\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 5.2 Feature-Selected Models"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Chi²-selected\n",
    "add_model_row(base_log_reg,       type_=\"Chi-Selected\", features=chi_selected)\n",
    "add_model_row(base_random_forest, type_=\"Chi-Selected\", features=chi_selected)\n",
    "add_model_row(base_decision_tree, type_=\"Chi-Selected\", features=chi_selected)\n",
    "\n",
    "# ANOVA-F-selected\n",
    "add_model_row(base_log_reg,       type_=\"Anova-F\", features=f_selected)\n",
    "add_model_row(base_random_forest, type_=\"Anova-F\", features=f_selected)\n",
    "add_model_row(base_decision_tree, type_=\"Anova-F\", features=f_selected)\n",
    "\n",
    "# RFECV-selected\n",
    "add_model_row(base_log_reg,       type_=\"RFECV\", features=rfecv_log_reg)\n",
    "add_model_row(base_random_forest, type_=\"RFECV\", features=rfecv_random_forest)\n",
    "add_model_row(base_decision_tree, type_=\"RFECV\", features=rfecv_decision_tree)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "models_table.sort_values(by=\"Accuracy\", ascending=False).reset_index(drop=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def metric_barplot(metric, ylim):\n",
    "    fig, ax = plt.subplots(figsize=(10, 5))\n",
    "    bars = sns.barplot(data=models_table, x=\"Model\", y=metric, hue=\"Type\", palette=\"viridis\", ax=ax)\n",
    "    ax.set_title(f\"Model Performance Comparison ({metric})\", weight=\"bold\")\n",
    "    ax.set_ylim(*ylim)\n",
    "    for container in bars.containers:\n",
    "        bars.bar_label(container, fmt=\"%.3f\", fontsize=8)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "metric_barplot(\"Accuracy\",  (0.6, 0.9))\n",
    "metric_barplot(\"Precision\", (0.4, 0.7))\n",
    "metric_barplot(\"F1\",        (0.4, 0.65))\n",
    "metric_barplot(\"CV\",        (0.67, 0.82))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Best configuration per model\n",
    "1. **Logistic Regression** → Baseline (feature selection did not help)\n",
    "2. **Decision Tree** → ANOVA-F\n",
    "3. **Random Forest** → ANOVA-F (higher F1 and CV than RFECV)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 6. Hyperparameter Tuning"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_best_params(param_grid, X, y, estimator, cv=5):\n",
    "    \"\"\"Grid-search inside the preprocessing pipeline.\"\"\"\n",
    "    pipe = Pipeline([\n",
    "        (\"preprocessor\", preprocessor),\n",
    "        (\"estimator\", estimator),\n",
    "    ])\n",
    "    prefixed = {f\"estimator__{k}\": v for k, v in param_grid.items()}\n",
    "    grid = GridSearchCV(pipe, prefixed, cv=cv, scoring=\"accuracy\")\n",
    "    grid.fit(X, y)\n",
    "    return grid.best_params_, grid.best_score_\n",
    "\n",
    "\n",
    "log_param_grid = {\n",
    "    \"C\":       [0.01, 0.1, 1, 10],\n",
    "    \"penalty\": [\"l1\", \"l2\"],\n",
    "    \"solver\":  [\"liblinear\"],\n",
    "}\n",
    "best_log_params, log_cv = get_best_params(log_param_grid, X_train, y_train, LogisticRegression(random_state=RANDOM_STATE))\n",
    "print(\"Logistic Regression:\", best_log_params, f\"| CV={log_cv:.4f}\")\n",
    "\n",
    "dt_param_grid = {\n",
    "    \"max_depth\":         [3, 5, 10, None],\n",
    "    \"min_samples_split\": [2, 5, 10],\n",
    "    \"min_samples_leaf\":  [1, 2, 4],\n",
    "    \"criterion\":         [\"gini\", \"entropy\"],\n",
    "}\n",
    "best_dt_params, dt_cv = get_best_params(dt_param_grid, X_train, y_train, DecisionTreeClassifier(random_state=RANDOM_STATE))\n",
    "print(\"Decision Tree      :\", best_dt_params, f\"| CV={dt_cv:.4f}\")\n",
    "\n",
    "rf_param_grid = {\n",
    "    \"max_depth\":         [5, 10, None],\n",
    "    \"min_samples_split\": [2, 5],\n",
    "    \"min_samples_leaf\":  [1, 2, 4],\n",
    "    \"n_estimators\":      [50, 100, 200],\n",
    "}\n",
    "best_rf_params, rf_cv = get_best_params(rf_param_grid, X_train, y_train, RandomForestClassifier(random_state=RANDOM_STATE))\n",
    "print(\"Random Forest      :\", best_rf_params, f\"| CV={rf_cv:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
